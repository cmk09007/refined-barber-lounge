# Cloudflare Pages redirects. Copied verbatim into site/ by build.py.
# Every URL this site has ever served must land somewhere, not 404.
# First match wins, so the explicit rules come before the splats.
#
# History: the site briefly shipped three design variants at /a/ /b/ /c/ with a
# chooser at /. The chooser is gone and Design A now lives at the root, so the
# variant paths fold into the flat pages. The github.io URLs carried the repo
# name as a path prefix (/refined-barber-lounge/...), so those fold in too.

/a/index.html           /                 301
/b/index.html           /                 301
/c/index.html           /                 301
/a                      /                 301
/b                      /                 301
/c                      /                 301
/a/                     /                 301
/b/                     /                 301
/c/                     /                 301
/a/*                    /:splat           301
/b/*                    /:splat           301
/c/*                    /:splat           301

/refined-barber-lounge/a/*   /:splat      301
/refined-barber-lounge/b/*   /:splat      301
/refined-barber-lounge/c/*   /:splat      301
/refined-barber-lounge/*     /:splat      301
/refined-barber-lounge       /            301
